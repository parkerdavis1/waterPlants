# Copy to .env (or the relevant .env.* variant) and fill in.
# Variables validated by src/lib/env.ts must be present or the app will refuse to start.

# Runtime
LOCAL_DEV=true
LOCAL_SEED=true
ORIGIN=http://localhost:3000
BODY_SIZE_LIMIT=5M

# Seeding and password reset. Required by `pnpm db:seed` and
# `pnpm db:resetPasswords`; the web server does not need it.
SEED_USER_PASSWORD=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
R2_BUCKET_BASE_URL=

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUBLIC_VAPID_KEY=

# Reverse proxy (production)
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
