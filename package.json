{
	"name": "waterplants",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"start": "node --env-file=.env build",
		"dev": "vite dev",
		"dev:docker": "docker compose -f docker-compose.local.yml up --build",
		"build": "vite build",
		"build:docker": "vite build && docker compose -f docker-compose.local.yml up --build",
		"deploy:droplet": "scripts/droplet.sh",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest",
		"db:studio": "npx drizzle-kit studio",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/db/migrate.ts",
		"db:reconcile": "tsx src/db/reconcileMigrations.ts",
		"db:seed": "tsx src/db/seed.ts",
		"db:resetPre": "touch src/db/migrations/something.txt && rm -rf src/db/migrations/* && rm -f src/db/local.db",
		"db:resetPost": "pnpm db:generate && pnpm db:migrate && pnpm db:seed",
		"db:reset": "pnpm db:resetPre && pnpm db:resetPost",
		"knip": "knip"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.5.0",
		"@flydotio/dockerfile": "^0.7.10",
		"@internationalized/date": "^3.12.3",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@types/eslint": "^9.6.1",
		"@types/node": "^26.2.0",
		"@types/node-cron": "^3.0.11",
		"@types/web-push": "^3.6.4",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/ui": "4.1.10",
		"autoprefixer": "^10.5.4",
		"bits-ui": "2.18.1",
		"cross-env": "^10.1.0",
		"daisyui": "^5.7.16",
		"drizzle-kit": "^0.31.10",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"formsnap": "^2.0.1",
		"globals": "^17.9.0",
		"knip": "^6.32.0",
		"lucia": "^3.2.2",
		"mode-watcher": "^1.1.0",
		"postcss": "^8.5.26",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "5.56.8",
		"svelte-check": "^4.7.5",
		"svelte-sonner": "^1.1.1",
		"sveltekit-superforms": "^2.30.2",
		"tailwindcss": "^3.4.17",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"vaul-svelte": "1.0.0-next.3",
		"vite": "^8.2.1",
		"vitest": "^4.1.10",
		"zod": "^3.25.76"
	},
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1106.0",
		"@libsql/client": "^0.17.4",
		"@lucia-auth/adapter-drizzle": "^1.1.0",
		"@lucide/svelte": "^1.30.0",
		"@node-rs/argon2": "^2.0.2",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@smithy/node-http-handler": "^4.9.13",
		"@unpic/svelte": "^1.0.1",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"node-cron": "^4.6.0",
		"tailwind-merge": "^2.6.0",
		"tailwind-variants": "^0.3.1",
		"tailwindcss-animate": "^1.0.7",
		"tsx": "^4.23.11",
		"ulid": "^3.0.2",
		"web-push": "^3.6.7"
	}
}
