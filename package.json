{
	"name": "waterplants",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"start": "node --env-file=.env build",
		"dev": "vite dev",
		"dev:docker": "docker compose -f docker-compose.local.yml up --build",
		"build": "vite build",
		"build:docker": "vite build && docker compose -f docker-compose.local.yml up --build",
		"deploy:droplet": "scripts/droplet.sh",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest",
		"db:studio": "npx drizzle-kit studio",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/db/migrate.ts",
		"db:reconcile": "tsx src/db/reconcileMigrations.ts",
		"db:seed": "tsx src/db/seed.ts",
		"db:resetPasswords": "tsx src/db/resetPasswords.ts",
		"db:resetPre": "touch src/db/migrations/something.txt && rm -rf src/db/migrations/* && rm -f src/db/local.db",
		"db:resetPost": "pnpm db:generate && pnpm db:migrate && pnpm db:seed",
		"db:reset": "pnpm db:resetPre && pnpm db:resetPost",
		"knip": "knip"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.6.0",
		"@flydotio/dockerfile": "^0.7.15",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-netlify": "^7.0.1",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@types/eslint": "^9.6.1",
		"@types/node": "^26.6.6",
		"@types/node-cron": "^3.0.11",
		"@types/web-push": "^3.6.4",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitest/ui": "5.0.5",
		"autoprefixer": "^10.6.2",
		"bits-ui": "2.20.2",
		"cross-env": "^10.1.0",
		"daisyui": "^5.7.50",
		"drizzle-kit": "^0.31.11",
		"embla-carousel-svelte": "^8.6.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"formsnap": "^2.1.0",
		"globals": "^17.13.0",
		"knip": "^6.44.1",
		"lucia": "^3.2.2",
		"mode-watcher": "^1.1.0",
		"postcss": "^8.5.32",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-sonner": "^1.2.2",
		"sveltekit-superforms": "^3.1.0",
		"tailwindcss": "^3.4.17",
		"tslib": "^2.9.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vaul-svelte": "1.0.0-next.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"zod": "^4.6.7"
	},
	"type": "module",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1161.0",
		"@libsql/client": "^0.18.0",
		"@lucia-auth/adapter-drizzle": "^1.1.0",
		"@lucide/svelte": "^1.66.0",
		"@node-rs/argon2": "^2.2.2",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@smithy/node-http-handler": "^4.14.1",
		"@unpic/svelte": "^1.0.1",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"dotenv": "^18.0.9",
		"drizzle-orm": "^0.45.4",
		"node-cron": "^4.6.0",
		"tailwind-merge": "^2.6.0",
		"tailwind-variants": "^0.3.1",
		"tailwindcss-animate": "^1.0.7",
		"tsx": "^4.23.15",
		"ulid": "^3.0.2",
		"web-push": "^3.6.7"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#src/*.js": "./src/*.ts",
		"#src/*.svelte": "./src/*.svelte",
		"#src/*": "./src/*"
	}
}
